# Copy this file to .env for local `netlify dev`, and set the same
# values as environment variables on your Netlify site for production.

# A passcode you choose, used to gate access to the app.
APP_PASSCODE=choose-a-passcode

# A long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=generate-a-long-random-string

# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY is secret — it is only ever used server-side
# inside Netlify Functions, never sent to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key (console.anthropic.com -> API Keys).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
